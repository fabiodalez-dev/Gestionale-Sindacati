RewriteEngine On

# Imposta la codifica UTF-8
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .css .js .xml .json .rss .atom

# Reindirizza solo la root del sito a login.php con un URL assoluto
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ /login.php [L,R=302]

# Protegge il file config.php impedendone l'accesso diretto
<Files "config.php">
    Require all denied
</Files>

# Protegge il file .env (credenziali database)
<Files ".env">
    Require all denied
</Files>

# Protegge i file di log
<FilesMatch "\.(log)$">
    Require all denied
</FilesMatch>
<Files "error_log">
    Require all denied
</Files>

# Protegge i file lock e di configurazione composer/npm
<FilesMatch "^(composer\.json|composer\.lock|package\.json|package-lock\.json)$">
    Require all denied
</FilesMatch>

# Protegge zip.md e altri file markdown
<FilesMatch "\.(md)$">
    Require all denied
</FilesMatch>
